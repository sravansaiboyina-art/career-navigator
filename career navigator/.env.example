# Career Navigator — Environment Configuration Template
VITE_APP_NAME="Career Navigator"
VITE_APP_TAGLINE="AI-Powered Career Guidance for Indian Students"
VITE_APP_VERSION="1.0.0-phase1"
VITE_APP_ENV="development"

# Database Configuration (options: 'indexeddb' | 'localstorage')
VITE_DB_TYPE="indexeddb"
VITE_DB_NAME="career_navigator_db"
VITE_DB_VERSION="2"

# Demo & Seed Settings
VITE_DEMO_SEED="true"
VITE_DEMO_DEFAULT_PERSONA="neet"

# Feature Flags
VITE_ENABLE_AI="false"
VITE_DEBUG="true"
