NODE_ENV=development
PORT=8787
HOST=127.0.0.1
# Keep the database on disk for local persistence. The directory is created automatically.
DATABASE_PATH=./data/career-navigator.sqlite
# Used only when the frontend is served from a different origin; comma-separated allowlist.
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# Optional. Leave blank to use the app's offline career-advice fallback.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
SESSION_MAX_AGE_DAYS=7
# Optional SMTP settings. Password-reset emails are sent only when SMTP_HOST and SMTP_FROM are set.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# The email link opens this frontend and routes to /reset-password.
PASSWORD_RESET_URL=http://127.0.0.1:5173
